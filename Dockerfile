# One Dockerfile for both binaries - they differ only in which cmd is built.
# Pass --build-arg BINARY=bridge or consumer.
FROM --platform=$BUILDPLATFORM golang:1.27-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS builder

ARG TARGETOS
ARG TARGETARCH
ARG BINARY

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w -X main.version=0.1.0" -o /out/app ./cmd/${BINARY}

# ---- runtime ----
FROM ghcr.io/cujarrett/base-distroless:static-debian13@sha256:723f8ed3b1060cf54014601bbb883e79f184bb949dcf85e19b209a69d6979ed9

WORKDIR /app

COPY --from=builder /out/app .

EXPOSE 8080 9090

ENTRYPOINT ["./app"]
